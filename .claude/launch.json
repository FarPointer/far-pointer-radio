{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Convergence Zone mockups (Python)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "shows/convergence-zone/website"],
      "port": 8080
    },
    {
      "name": "Convergence Zone mockups (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3000", "shows/convergence-zone/website"],
      "port": 3000
    }
  ]
}
